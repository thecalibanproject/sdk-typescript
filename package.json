{
  "name": "@caliban/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Caliban: OpenAI-compatible data-plane client with Caliban extensions, typed admin API client, and node authoring types.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "gen:api": "openapi-typescript ../core/api/openapi.yaml --default-non-nullable false --output src/generated/schema.ts",
    "gen:schemas": "node scripts/gen-schemas.mjs",
    "gen": "pnpm gen:api && pnpm gen:schemas",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "caliban",
    "ai-gateway",
    "openai",
    "llm",
    "byok"
  ],
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "author": "Elie Sfeir <elie@internalizable.dev>"
}
